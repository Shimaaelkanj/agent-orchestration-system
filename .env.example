@'
# ---- Models: default is local Ollama (no API key needed) ----
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
SUPERVISOR_PROVIDER=openai
SUPERVISOR_MODEL=llama3.2
SPECIALIST_PROVIDER=openai
SPECIALIST_MODEL=llama3.2
REVIEWER_PROVIDER=openai
REVIEWER_MODEL=llama3.2
# Cloud alternative: delete OPENAI_BASE_URL and set real keys/models (or use anthropic + ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# ---- Memory (local mode) ----
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
WORKING_MEMORY_BACKEND=auto
REDIS_URL=redis://localhost:6379/0
MEMORY_USER_ID=default
ADMIN_API_KEY=

# ---- Human in the loop ----
CONFIDENCE_THRESHOLD=0.6
PLAN_CONFIDENCE_THRESHOLD=0.5
NOTIFY_BELOW=0.8
PLAN_FALLBACK=1
PLAN_FALLBACK_CONFIDENCE=0.4
# NOTIFY_WEBHOOK_URL=

# ---- Tools ----
API_ALLOWED_HOSTS=api.github.com,httpbin.org

# ---- Docker (docker compose) ----
# The Chroma client in the image and the Chroma server image must be the same version.
CHROMA_VERSION=1.5.9
# Host port of the API (inside Docker it is always 8080)
API_PORT=8081
# Use the scripted demo agents (1) or your real models (0)
DEMO_MODE=1
# Docker uses a local hash embedder by default; set "ollama" to use Ollama on your PC
# DOCKER_EMBED_PROVIDER=ollama
# DOCKER_USE_LLM_EXTRACTION=1

# ---- Observability (optional) ----
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
'@ | Set-Content -Path .env.example -Encoding ascii
